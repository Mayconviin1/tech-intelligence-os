generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Profile ──────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           Profile?
  skills            UserSkill[]
  interests         UserInterest[]
  followedCompanies UserCompany[]
  followedTechs    UserTechnology[]
  savedItems        SavedItem[]
  jobApplications   JobApplication[]
  alertRules        AlertRule[]
  feedback          UserFeedback[]
  aiConversations   AIConversation[]
  learningPaths     LearningPath[]
  githubAccount     GitHubAccount?
  linkedinAccount   LinkedInAccount?
  calendarAccounts  CalendarAccount[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  headline         String?
  bio              String?
  location         String?
  experienceYears  Int?
  education        String?
  languages        String?
  certifications   String?
  desiredRoles     String?
  desiredSalary    String?
  desiredCountries String?
  remotePreference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Skills & Technologies ───────────────────────────────

model Skill {
  id   String @id @default(cuid())
  name String @unique

  users UserSkill[]
}

model UserSkill {
  id       String  @id @default(cuid())
  userId   String
  skillId  String
  level    String? // MASTERED, LEARNING, WANT_TO_LEARN, MONITORING

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Technology {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?

  users     UserTechnology[]
  trends    Trend[]
  newsItems NewsItem[]
}

model UserTechnology {
  id           String  @id @default(cuid())
  userId       String
  technologyId String
  status       String? // MASTERED, LEARNING, WANT_TO_LEARN, MONITORING

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([userId, technologyId])
}

model Interest {
  id   String @id @default(cuid())
  name String @unique

  users UserInterest[]
}

model UserInterest {
  id         String  @id @default(cuid())
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

// ─── News & Intelligence ─────────────────────────────────

model Source {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  type      String   // PRIMARY, OFFICIAL_BLOG, OFFICIAL_DOCS, JOURNALISM, OTHER
  quality   Int      @default(5) // 1-10
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  newsItems     NewsItem[]     @relation("SourceNewsItems")
  newsEvents    NewsEvent[]    @relation("SourceNewsEvents")
  jobListings   JobListing[]
  eventListings EventListing[]
}

model NewsItem {
  id               String   @id @default(cuid())
  title            String
  url              String   @unique
  author           String?
  publishedAt      DateTime
  retrievedAt      DateTime @default(now())
  imageUrl         String?
  category         String
  tags             String? // JSON array
  summary          String?
  aiSummary        String?
  importance       Int      @default(5) // 1-100
  personalRelevance Int     @default(0) // 0-100
  sourceQuality    Int      @default(5)
  confirmed        Boolean  @default(true)
  sourceId         String
  eventId          String?
  technologyId     String?

  source     Source      @relation("SourceNewsItems", fields: [sourceId], references: [id])
  event      NewsEvent?  @relation("EventItems", fields: [eventId], references: [id])
  technology Technology? @relation(fields: [technologyId], references: [id])
  savedItems SavedItem[]
}

model NewsEvent {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String
  importance     Int      @default(5)
  sourceCount    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items  NewsItem[] @relation("EventItems")
  source Source?    @relation("SourceNewsEvents", fields: [sourceId], references: [id])
  sourceId String?
}

// ─── Trends ──────────────────────────────────────────────

model Trend {
  id           String   @id @default(cuid())
  name         String
  category     String?
  score        Int      @default(50)
  growth       Float    @default(0)
  period       String   @default("monthly")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technologyId String?

  technology Technology? @relation(fields: [technologyId], references: [id])
}

// ─── Companies ───────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  domain      String?
  logoUrl     String?
  description String?
  category    String?
  createdAt   DateTime @default(now())

  users    UserCompany[]
  jobs     JobListing[]
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  followed  Boolean  @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ─── Startups ────────────────────────────────────────────

model Startup {
  id          String   @id @default(cuid())
  name        String   @unique
  domain      String?
  logoUrl     String?
  description String?
  sector      String?
  country     String?
  funding     String?
  founders    String?
  createdAt   DateTime @default(now())
}

// ─── Jobs ────────────────────────────────────────────────

model JobListing {
  id              String   @id @default(cuid())
  title           String
  company         String
  companyId       String?
  location        String?
  remote          Boolean  @default(false)
  remoteCountry   String?
  salary          String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  description     String?
  url             String   @unique
  category        String?
  seniority       String?
  technologies    String? // JSON array
  visaSponsorship Boolean?
  workAuth        String?
  publishedAt     DateTime
  retrievedAt     DateTime @default(now())
  matchScore      Int?     // 0-100
  eligibility     String?  // GOOD, ATTENTION, LOW, UNKNOWN

  source    Source?          @relation(fields: [sourceId], references: [id])
  sourceId  String?
  companyRel Company?        @relation(fields: [companyId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String?
  userId      String
  status      String   @default("SAVED") // SAVED, APPLIED, INTERVIEW, TECHNICAL_TEST, OFFER, REJECTED, WITHDRAWN
  notes       String?
  salary      String?
  contact     String?
  nextAction  String?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job  JobListing? @relation(fields: [jobId], references: [id])
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Events ──────────────────────────────────────────────

model EventListing {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  time        String?
  timezone    String?
  location    String?
  online      Boolean  @default(false)
  price       String?
  organizer   String?
  url         String   @unique
  category    String?
  relevance   Int      @default(5)
  createdAt   DateTime @default(now())

  source   Source? @relation(fields: [sourceId], references: [id])
  sourceId String?
}

// ─── Saved Items / Knowledge Vault ───────────────────────

model SavedItem {
  id          String   @id @default(cuid())
  userId      String
  url         String?
  title       String?
  description String?
  category    String?
  tags        String? // JSON array
  technology  String?
  summary     String?
  importance  Int      @default(5)
  itemType    String   @default("URL") // URL, NOTE, DOCUMENT, VIDEO, COURSE, TOOL
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsItem NewsItem? @relation(fields: [newsItemId], references: [id])
  newsItemId String?
}

// ─── Documents & RAG ─────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  title       String
  content     String
  source      String?
  type        String   @default("text")
  createdAt   DateTime @default(now())

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  embedding  String? // JSON array of floats
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── Tags ────────────────────────────────────────────────

model Tag {
  id   String @id @default(cuid())
  name String @unique
}

// ─── Notifications ───────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("INFO") // INFO, IMPORTANT, CRITICAL
  read      Boolean  @default(false)
  url       String?
  createdAt DateTime @default(now())
}

// ─── Alert Rules ─────────────────────────────────────────

model AlertRule {
  id        String   @id @default(cuid())
  userId    String
  type      String   // KEYWORD, COMPANY, TECHNOLOGY, JOB, EVENT
  query     String
  enabled   Boolean  @default(true)
  frequency String   @default("INSTANT") // INSTANT, DAILY, WEEKLY
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AI ──────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // USER, ASSISTANT, SYSTEM
  content        String
  sources        String? // JSON array
  tokensUsed     Int?
  model          String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Learning ────────────────────────────────────────────

model LearningPath {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items LearningItem[]
}

model LearningItem {
  id          String   @id @default(cuid())
  pathId      String
  title       String
  description String?
  url         String?
  type        String   // COURSE, ARTICLE, VIDEO, PROJECT, DOCUMENTATION
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
}

// ─── Integrations ────────────────────────────────────────

model GitHubAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  githubId     String   @unique
  username     String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkedInAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  linkedinId   String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // GOOGLE, OUTLOOK
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Recommendations ─────────────────────────────────────

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // READ, LEARN, APPLY, ATTEND, FOLLOW, BUILD
  title     String
  reason    String
  url       String?
  score     Int      @default(50)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── User Feedback ───────────────────────────────────────

model UserFeedback {
  id        String   @id @default(cuid())
  userId    String
  type      String   // RELEVANT, NOT_RELEVANT, SAVE, IMPORTANT, DONT_SHOW
  targetId  String
  targetType String  // NEWS, JOB, TREND, EVENT, RECOMMENDATION
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
